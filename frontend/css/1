/* =========================================
   2. RESET & GLOBAL STYLES
========================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
}

body {
    font-family: var(--font-body);
    background: var(--bg-primary);
    color: var(--text-primary);
    line-height: 1.7;
    overflow-x: hidden;
    background: var(--bg-primary);
}

body,
button,
input,
textarea {
    font-family: var(--font-body);
}

img {
    display: block;
    max-width: 100%;
}

a {
    text-decoration: none;
    color: inherit;
}

button {
    cursor: pointer;
    border: none;
}

ul {
    list-style: none;
}

::selection {
    background: var(--accent-primary);
    color: white;
}

:focus-visible {
    outline: 2px solid var(--accent-secondary);
    outline-offset: 4px;
}

.container {
    width: min(
        var(--container-width),
        calc(100% - 48px)
    );
    margin-inline: auto;
}

.section {
    padding: 110px 0;
    position: relative;
}

.section:nth-of-type(even) {
    background: var(--bg-secondary);
}


/* =========================================
   3. TYPOGRAPHY
========================================= */

h1,
h2,
h3,
h4 {
    font-family: var(--font-heading);
    line-height: 1.2;
    font-weight: 700;
}

h1 {
    font-size: clamp(2.8rem, 6vw, 5rem);
    letter-spacing: -2px;
}

h2 {
    font-size: clamp(2rem, 4vw, 3rem);
}

h3 {
    font-size: 1.35rem;
}

p {
    color: var(--text-secondary);
}

.gradient-text {
    background: var(--accent-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}


/* =========================================
   4. HEADER & NAVIGATION
========================================= */

.site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(11, 13, 18, 0.85);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border-bottom: 1px solid var(--border-color);
}

.nav-container {
    min-height: 82px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-family: var(--font-heading);
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.5px;
}

.logo-bracket {
    color: var(--accent-primary);
}

.nav {
    display: flex;
    align-items: center;
    gap: 28px;
}

.nav-link {
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    transition: var(--transition);
}

.nav-link:hover,
.nav-link.active {
    color: var(--text-primary);
}

.nav-link.active {
    position: relative;
}

.nav-link.active::after {
    content: "";
    position: absolute;
    width: 5px;
    height: 5px;
    background: var(--accent-secondary);
    border-radius: 50%;
    bottom: -12px;
    left: 50%;
    transform: translateX(-50%);
}

.menu-toggle {
    display: none;
    background: transparent;
    color: white;
}


/* =========================================
   5. BUTTONS
========================================= */

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    padding: 14px 25px;

    border-radius: var(--radius-small);

    background: var(--accent-gradient);
    color: #080b12;

    font-weight: 700;
    font-size: 0.95rem;

    transition:
        transform var(--transition),
        box-shadow var(--transition);
}

.btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(139, 92, 246, 0.25);
}

.btn-small {
    padding: 10px 18px;
    font-size: 0.85rem;
}

.btn-outline {
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border-color);
}

.btn-outline:hover {
    border-color: var(--accent-primary);
    box-shadow: none;
}


/* =========================================
   6. HERO SECTION
========================================= */

.hero {
    min-height: 680px;
    display: flex;
    align-items: center;
    overflow: hidden;

    background:
        radial-gradient(
            ellipse at 15% 20%,
            rgba(139, 92, 246, 0.12),
            transparent 40%
        ),
        radial-gradient(
            ellipse at 85% 70%,
            rgba(56, 189, 248, 0.09),
            transparent 35%
        ),
        var(--bg-primary);
}

/* .hero-grid { */
    /* display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 70px; */
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 70px;
}

.eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;

    color: var(--accent-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 2px;

    margin-bottom: 25px;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 12px #22c55e;
}

.hero-content h1 {
    margin-bottom: 15px;
}

.hero-content h2 {
    font-size: clamp(1.3rem, 3vw, 2rem);
    color: var(--text-secondary);
    margin-bottom: 22px;
}

.hero-description {
    max-width: 550px;
    font-size: 1.05rem;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}

.social-links {
    display: flex;
    gap: 25px;
    margin-top: 35px;
}

.social-links a {
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: var(--transition);
}

.social-links a:hover {
    color: var(--accent-secondary);
}


/* Hero image */

.hero-image-wrapper {
    position: relative;
    width: min(100%, 370px);
    margin-inline: auto;
}

.hero-image-card {
    padding: 12px;
    border-radius: 30px;

    background: linear-gradient(
        145deg,
        rgba(167, 139, 250, 0.7),
        rgba(56, 189, 248, 0.15)
    );

    box-shadow: var(--shadow-card);
}

.hero-image {
    width: 100%;
    height: 430px;
    object-fit: cover;
    object-position: center;
    border-radius: 22px;
    background: var(--bg-card);
}

.floating-card {
    position: absolute;
    bottom: 35px;
    left: -55px;

    display: flex;
    align-items: center;
    gap: 12px;

    padding: 16px 20px;
    border: 1px solid var(--border-color);
    border-radius: 14px;

    background: rgba(21, 25, 35, 0.9);
    backdrop-filter: blur(12px);

    box-shadow: var(--shadow-card);
}

.floating-icon {
    font-size: 1.7rem;
    color: var(--accent-secondary);
}

.floating-card strong {
    font-size: 0.9rem;
}

.floating-card p {
    font-size: 0.75rem;
    margin-top: 3px;
}


/* =========================================
   7. SECTION HEADINGS
========================================= */

.section-heading {
    max-width: 650px;
    text-align: center;
    margin: 0 auto 65px;
}

.section-label {
    color: var(--accent-secondary);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.section-heading h2 {
    margin-bottom: 16px;
}

.section-heading > p:last-child {
    font-size: 1rem;
}


/* =========================================
   8. ABOUT SECTION
========================================= */

.about-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 70px;
    align-items: center;
}

.about-text h3 {
    font-size: 1.8rem;
    margin-bottom: 22px;
}

.about-text p {
    margin-bottom: 18px;
}

.about-text .btn {
    margin-top: 15px;
}

.about-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.stat-card {
    padding: 30px 20px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-medium);
    text-align: center;
    transition: var(--transition);
}

.stat-card:hover {
    transform: translateY(-5px);
    border-color: var(--border-hover);
}

.stat-card h3 {
    font-size: 2rem;
    background: var(--accent-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.stat-card p {
    margin-top: 8px;
    font-size: 0.85rem;
}


/* =========================================
   9. SKILLS SECTION
========================================= */

.skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.skill-card {
    padding: 25px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-medium);
    transition: var(--transition);
}

.skill-card:hover {
    transform: translateY(-6px);
    border-color: var(--border-hover);
    background: var(--bg-card-hover);
}

.skill-card h3 {
    margin-bottom: 10px;
}

.skill-card p {
    font-size: 0.88rem;
}

.skill-level {
    height: 6px;
    margin-top: 18px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}

.skill-level span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--accent-gradient);
}

.loading-text {
    grid-column: 1 / -1;
    text-align: center;
    padding: 30px;
}


/* =========================================
   10. EXPERIENCE TIMELINE
========================================= */

.timeline {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
}

.timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 10px;
    width: 2px;
    background: linear-gradient(
        to bottom,
        var(--accent-primary),
        var(--accent-secondary)
    );
}

.timeline-item {
    position: relative;
    padding-left: 50px;
    margin-bottom: 30px;
}

.timeline-marker {
    position: absolute;
    top: 25px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--accent-primary);
    border: 4px solid var(--bg-secondary);
    box-shadow: 0 0 15px rgba(139, 92, 246, 0.5);
}

.timeline-card {
    padding: 28px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-medium);
    transition: var(--transition);
}

.timeline-card:hover {
    border-color: var(--border-hover);
    transform: translateX(5px);
}

.timeline-date {
    color: var(--accent-secondary);
    font-size: 0.8rem;
    font-weight: 600;
}

.timeline-card h3 {
    margin: 12px 0 7px;
}

.timeline-card h4 {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 12px;
}

.timeline-card p {
    font-size: 0.9rem;
}


/* =========================================
   11. PROJECTS SECTION
========================================= */

.projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 25px;
}

.project-card {
    overflow: hidden;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-large);
    transition: var(--transition);
    transition: 0.3s ease;
}

.project-card:hover {
    transform: translateY(-7px);
    border-color: var(--border-hover);
    box-shadow: var(--shadow-card);
    transform: translateY(-7px);
}

.project-image {
    width: 100%;
    height: 230px;
    object-fit: cover;
    background: var(--bg-secondary);
}

.project-content {
    padding: 25px;
}

.project-content h3 {
    margin-bottom: 12px;
}

.project-content p {
    font-size: 0.9rem;
    margin-bottom: 18px;
}

.project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
}

.project-tags span {
    padding: 6px 11px;
    border-radius: 30px;
    color: var(--accent-secondary);
    background: rgba(56, 189, 248, 0.08);
    font-size: 0.75rem;
}

.project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

.project-links a {
    color: var(--accent-secondary);
    font-size: 0.85rem;
    font-weight: 600;
}

.project-links a:hover {
    color: var(--accent-primary);
}


/* =========================================
   12. CONTACT SECTION
========================================= */

.contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 70px;
}

.contact-info h3 {
    font-size: 1.8rem;
    margin-bottom: 18px;
}

.contact-info > p {
    margin-bottom: 30px;
}

.contact-detail {
    margin-top: 25px;
}

.contact-detail span {
    display: block;
    color: var(--text-muted);
    font-size: 0.8rem;
    margin-bottom: 5px;
}

.contact-detail a,
.contact-detail p {
    color: var(--text-primary);
    font-weight: 500;
    overflow-wrap: anywhere;
}

.contact-detail a:hover {
    color: var(--accent-secondary);
}


/* Contact form */

.contact-form {
    padding: 35px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-large);
}

.form-group {
    margin-bottom: 22px;
}

.form-group label {
    display: block;
    margin-bottom: 9px;
    font-size: 0.9rem;
    font-weight: 600;
}

.form-group input,
.form-group textarea {
    width: 100%;
    padding: 14px 16px;

    color: var(--text-primary);
    background: var(--bg-secondary);

    border: 1px solid var(--border-color);
    border-radius: var(--radius-small);

    font-size: 0.9rem;
    outline: none;

    transition: var(--transition);
}

.form-group input:focus,
.form-group textarea:focus {
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.12);
}

.form-group textarea {
    resize: vertical;
    min-height: 130px;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: var(--text-muted);
}

.contact-form .btn {
    width: 100%;
}

.form-status {
    margin-top: 15px;
    font-size: 0.9rem;
}


/* =========================================
   13. FOOTER
========================================= */

.footer {
    padding: 35px 0;
    border-top: 1px solid var(--border-color);
    background: var(--bg-secondary);
}

.footer-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.footer-content p {
    font-size: 0.82rem;
    text-align: center;
}


/* =========================================
   14. ANIMATIONS
========================================= */

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.hero-content {
    animation: fadeInUp 0.8s ease both;
}

.hero-image-wrapper {
    animation: fadeInUp 1s ease both;
}


/* =========================================
   15. ACCESSIBILITY
========================================= */

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
} */
